#!/bin/sh
# Git supplies local-ref local-oid remote-ref remote-oid on stdin.
main_update=0
while read -r _local_ref _local_oid remote_ref _remote_oid; do
    if [ "$remote_ref" = refs/heads/main ]; then main_update=1; fi
done
[ "$main_update" = 1 ] || exit 0
[ "${BITBRUSH_ALLOW_MAIN_PUSH:-}" = 1 ] && exit 0
# Opening the controlling terminal fails closed in noninteractive automation.
if ! ( : </dev/tty ) 2>/dev/null; then
    echo 'Main push cancelled: no terminal.' >&2
    exit 1
fi
# Exact approved prompt includes a literal typographic apostrophe.
# shellcheck disable=SC1112
printf 'You’re pushing directly to main. This may deploy to production. Continue? [y/N] ' >/dev/tty
answer=''
IFS= read -r answer </dev/tty || exit 1
case "$answer" in
    [yY]|[yY][eE][sS]) exit 0 ;;
    *) echo 'Main push cancelled.' >&2; exit 1 ;;
esac
